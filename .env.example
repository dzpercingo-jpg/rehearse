# Server-side environment variables for Rehearse.
# Copy to .env.local for local dev, or set in your hosting provider for prod.

# Public URL of THIS server (where the Speech Engine should dial in).
# Examples:
#   - local dev with ngrok:   PUBLIC_WS_URL=wss://abcd1234.ngrok.app/ws
#   - Render:                 PUBLIC_BASE_URL=rehearse.onrender.com
# Set either PUBLIC_WS_URL (takes precedence) OR PUBLIC_BASE_URL.
PUBLIC_WS_URL=
PUBLIC_BASE_URL=

# ElevenLabs creds — required for the Speech Engine WS handler in server.ts.
# Run /setup in the app to mint the engine id, then copy it here for prod.
ELEVENLABS_API_KEY=
ELEVENLABS_ENGINE_ID=
